<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <AssemblyName>AntigravityLauncher</AssemblyName>
    <RootNamespace>AntigravityLauncher</RootNamespace>
    <Version>0.0.3</Version>
    <Company>Antigravity Community</Company>
    <Product>Antigravity No-TUN Launcher</Product>
    <Description>True standalone single-file launcher for Antigravity with auto path discovery and embedded version.dll.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\version.dll" LogicalName="version.dll" />
    <EmbeddedResource Include="..\assets\config.json" LogicalName="config.json" />
  </ItemGroup>

</Project>
