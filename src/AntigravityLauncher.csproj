<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <AssemblyName>AntigravityLauncher</AssemblyName>
    <RootNamespace>AntigravityLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Antigravity Community</Company>
    <Product>Antigravity No-TUN Launcher</Product>
    <Description>Auto-discover Antigravity path and keep version.dll and config.json intact after updates.</Description>
  </PropertyGroup>

</Project>
